# backend/.env.example — the AI keys the backend expects (no real value here).
# Copy the lines you need into backend/salescommands/.env (the file read by
# settings.py, environ.Env.read_env()) or set them in the hosting environment.

# OpenAI API key, read by the openai SDK (every AI pipeline, deal health included).
OPENAI_API_KEY=

# Anthropic API key, read by the anthropic SDK — needed only when DEAL_HEALTH_LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=

# The deal health's LLM provider: openai (default) or claude.
DEAL_HEALTH_LLM_PROVIDER=openai
