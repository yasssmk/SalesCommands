# backend/.env.example — the AI secret keys the backend expects (no real value here).
# Copy the lines you need into backend/salescommands/.env (the file read by
# settings.py, environ.Env.read_env()) or set them in the hosting environment.
# Settings (such as the deal health's provider) live in the code, not here.

# OpenAI API key, read by the openai SDK (every AI pipeline, deal health included).
OPENAI_API_KEY=

# Anthropic API key, read by the anthropic SDK — needed only when the deal health runs on Claude.
ANTHROPIC_API_KEY=
